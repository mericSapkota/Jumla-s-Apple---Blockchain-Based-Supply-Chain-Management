# Copy this file to .env and fill in the values. .env is gitignored.
# Loaded into Spring's property resolution by spring-dotenv at startup.

# ── URLs ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/jumla_db
DB_USERNAME=postgres
DB_PASSWORD=

# ── JWT (generate: openssl rand -hex 64) ──────────
JWT_SECRET=change-me
JWT_EXPIRATION=86400000

# ── Blockchain (Web3j) ────────────────────────────
WEB3J_CLIENT_ADDRESS=http://127.0.0.1:8545
WEB3J_CONTRACT_ADDRESS=
WEB3J_DEPLOYER_PRIVATE_KEY=

# ── File upload (absolute path to the Vite frontend's public/ dir) ──
UPLOAD_FRONTEND_PUBLIC_DIR=/absolute/path/to/frontend/public

# ── Gmail SMTP (App Password from Google Account → Security → App Passwords) ──
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# ── eSewa ePay v2 (donations) ─────────────────────
# UAT defaults shown; for production use the epay.esewa.com.np URL + real creds.
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# ── Donation recipient ────────────────────────────
DONATION_RECIPIENT_NAME=Your Name
DONATION_RECIPIENT_PHONE=98XXXXXXXX

# ── Superadmin seed account (created at startup if missing) ──
ADMIN_EMAIL=admin@jumla.org
ADMIN_PASSWORD=ChangeMe@123

# ── Google OAuth 2.0 Client ID (Web application) ──
GOOGLE_CLIENT_ID=
