# Copy this file to .env and fill in the values. .env is gitignored.
# Loaded into Spring's property resolution by spring-dotenv at startup.

# ── URLs ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/jumla_db
DB_USERNAME=postgres
DB_PASSWORD=

# ── JWT (generate: openssl rand -hex 64) ──────────
JWT_SECRET=change-me
JWT_EXPIRATION=86400000

# ── Blockchain (Web3j) ────────────────────────────
# Local dev defaults shown. For Sepolia use an RPC URL + the matching chain id:
#   WEB3J_CLIENT_ADDRESS=https://sepolia.infura.io/v3/<KEY>   (or Alchemy / public RPC)
#   WEB3J_CHAIN_ID=11155111
# The deployer key must hold Sepolia ETH (from a faucet) and be authorized by
# the contract, since the backend signs assignRole with it.
WEB3J_CLIENT_ADDRESS=http://127.0.0.1:8545
WEB3J_CONTRACT_ADDRESS=
WEB3J_DEPLOYER_PRIVATE_KEY=
# Chain id the backend signs with (EIP-155). Sepolia=11155111, Ganache=1337,
# Hardhat=31337. Must match the network WEB3J_CLIENT_ADDRESS points at.
WEB3J_CHAIN_ID=11155111
# Static gas for backend-signed writes. Testnet gas is free — keep the price
# comfortably above Sepolia's base fee. gas-limit ~1.5M is plenty for assignRole.
WEB3J_GAS_PRICE_WEI=30000000000
WEB3J_GAS_LIMIT=1500000

# ── File upload (absolute path to the Vite frontend's public/ dir) ──
UPLOAD_FRONTEND_PUBLIC_DIR=/absolute/path/to/frontend/public

# ── Mail ───────────────────────────────────────────
# Local dev: run `docker compose up -d mailpit` (repo root) and leave these
# defaults — Mailpit needs no auth/TLS and catches mail at http://localhost:8025
# instead of sending it anywhere real.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Production: point at a real SMTP provider instead, e.g. Gmail
# (App Password from Google Account → Security → App Passwords), SES, Postmark...
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=<app password>
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true

# ── eSewa ePay v2 (donations) ─────────────────────
# UAT defaults shown; for production use the epay.esewa.com.np URL + real creds.
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# ── Donation recipient ────────────────────────────
DONATION_RECIPIENT_NAME=Your Name
DONATION_RECIPIENT_PHONE=98XXXXXXXX

# ── Superadmin seed account (created at startup if missing) ──
ADMIN_EMAIL=admin@jumla.org
ADMIN_PASSWORD=ChangeMe@123

# ── Google OAuth 2.0 Client ID (Web application) ──
GOOGLE_CLIENT_ID=

# ── AI chat assistant (Google Gemini) ──
# Get a key from https://aistudio.google.com/apikey. Leave blank to run the chat
# widget with a canned fallback reply instead of live AI responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
